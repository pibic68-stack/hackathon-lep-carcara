# Copie este arquivo para ".env" (mesma pasta) e preencha. O ".env" NUNCA vai para o GitHub.
# Chave gratuita: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Opcional: outro modelo do Gemini (padrão: gemini-3.1-flash-lite)
# PRISMA_IA_MODELO=gemini-3.1-flash-lite
